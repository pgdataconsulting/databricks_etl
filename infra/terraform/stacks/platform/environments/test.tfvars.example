# Platform stack, test environment.
# Copy to test.tfvars (ignored by Git) and replace the placeholders.

subscription_id = "00000000-0000-0000-0000-000000000000"
environment     = "test"
location        = "westeurope"

# Makes the storage account and Key Vault names globally unique. Choose once.
name_suffix = "t4m2"

storage_replication_type = "ZRS"

# Entra object IDs of the people or group who maintain source-system
# credentials in the Key Vault.
key_vault_secrets_officer_principal_ids = [
  "00000000-0000-0000-0000-000000000000",
]

tags = {
  cost_center = "0000"
}
